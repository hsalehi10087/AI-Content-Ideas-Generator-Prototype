# Choose "ollama" (free, runs on your computer) or "grok" (xAI API)
LLM_PROVIDER="ollama"

# Ollama settings (used when LLM_PROVIDER="ollama")
OLLAMA_MODEL="llama3.1"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Grok settings (used when LLM_PROVIDER="grok")
XAI_API_KEY="xai-xxx"
GROK_MODEL="grok-3-mini"